{
  "expo": {
    "name": "Miam Miam Gestion",
    "slug": "miam-miam-gestion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoMiamMiam.png",
    "scheme": "miammiamgestion",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/LogoMiamMiam.png",
        "backgroundImage": "./assets/images/LogoMiamMiam.png",
        "monochromeImage": "./assets/images/LogoMiamMiam.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lalarson007.miammiamgestion"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/LogoMiamMiam.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/LogoMiamMiam.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d8631bc-b42b-48d1-a072-2dc2f3403fa8"
      }
    },
    "owner": "lalarson007"
  }
}
